<header id="titlebar" class="titlebar">
  <div class="titlebar-controls left">
    <button id="tb-menu" class="titlebar-btn menu" type="button" title="窗口菜单" aria-label="窗口菜单" aria-haspopup="menu" aria-expanded="false"></button>
  </div>
  <div id="titlebar-inner" class="titlebar-title">
    <a href="<%= url_for('/') %>">
      <% if (page.title){ %>
        <%= theme.window_title_prefix || '' %><%= page.title %>
      <% } else { %>
        <%= config.title %><% if (config.subtitle){ %> - <%= config.subtitle %><% } %>
      <% } %>
    </a>
  </div>
  <div class="titlebar-controls right">
    <button id="tb-min" class="titlebar-btn min" type="button" title="收起 / 展开侧栏" aria-label="收起或展开侧栏" aria-pressed="false"></button>
    <button id="tb-max" class="titlebar-btn max" type="button" title="专注模式（隐藏侧栏、菜单和前面板）" aria-label="专注模式" aria-pressed="false"></button>
  </div>
  <div class="titlebar-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="titlebar-progress-fill"></span></div>
</header>
