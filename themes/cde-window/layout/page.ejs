<article class="page cde-panel">
  <header class="page-header">
    <h1 class="page-title"><%= page.title %></h1>
  </header>
  <div class="page-content">
    <% if (theme.about && (theme.about.photo_url || (theme.about.items && theme.about.items.length))){ %>
    <div class="author-page">
      <% if (theme.about.photo_url){ %>
        <a class="photo" href="javascript:;">
          <img src="<%- url_for(theme.about.photo_url) %>" alt="<%= config.author %>">
        </a>
      <% } %>
      <div class="author">
        <% if (config.author){ %>
          <p><strong>姓名：</strong><%= config.author %></p>
        <% } %>
        <% (theme.about.items || []).forEach(function(item){ %>
          <p>
            <strong><%= item.label %>：</strong>
            <% if (item.url){ %>
              <a href="<%= item.url %>" target="_blank"><%= item.title %></a>
            <% } else { %>
              <%= item.title %>
            <% } %>
          </p>
        <% }); %>
      </div>
    </div>
    <% } %>
    <%- page.content %>
  </div>
</article>

<%- partial('partials/comments') %>