include _partial/helpers

if page.title
  - var current_title = page.title
else
  - var current_title = config.title

if config.feed
  case config.feed.type
    when 'rss2'
      - var feed_type='application/rss+xml'
    when 'atom'
    default
      - var feed_type='application/atom+xml'

doctype html
html(lang='#{config.language}')
  head
    meta(http-equiv='content-type', content='text/html; charset=utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(content='yes', name='apple-mobile-web-app-capable')
    meta(content='black-translucent', name='apple-mobile-web-app-status-bar-style')
    meta(content='telephone=no', name='format-detection')
    - var page_url = is_home() ? config.url + config.root : full_url_for(page.path)
    - var page_description = page.description || (page.excerpt ? strip_html(page.excerpt) : '') || (page.content ? strip_html(page.content) : '') || config.description
    - page_description = page_description.replace(/\s+/g, ' ').trim().substring(0, 150)
    meta(name='description', content=page_description)
    if config.keywords
      meta(name="keywords",content=config.keywords)
    link(rel='canonical', href=page_url)
    meta(property='og:type', content=is_post() ? 'article' : 'website')
    meta(property='og:site_name', content=config.title)
    meta(property='og:title', content=page.title || config.title)
    meta(property='og:description', content=page_description)
    meta(property='og:url', content=page_url)
    meta(property='og:locale', content='zh_CN')
    if is_post() && page.date
      meta(property='article:published_time', content=page.date.toISOString())
      if page.updated
        meta(property='article:modified_time', content=page.updated.toISOString())
      for category in page.categories.toArray()
        meta(property='article:section', content=category.name)
      for tag in page.tags.toArray()
        meta(property='article:tag', content=tag.name)
    meta(name='twitter:card', content='summary')
    meta(name='twitter:title', content=page.title || config.title)
    meta(name='twitter:description', content=page_description)
    if is_post()
      - var article_jsonld = { '@context': 'https://schema.org', '@type': 'BlogPosting', 'headline': page.title, 'description': page_description, 'datePublished': page.date ? page.date.toISOString() : undefined, 'dateModified': page.updated ? page.updated.toISOString() : (page.date ? page.date.toISOString() : undefined), 'author': { '@type': 'Person', 'name': config.author }, 'publisher': { '@type': 'Organization', 'name': config.title }, 'mainEntityOfPage': { '@type': 'WebPage', '@id': page_url } }
      if page.photos && page.photos.length
        - article_jsonld.image = full_url_for(page.photos[0])
      script(type='application/ld+json')!= JSON.stringify(article_jsonld)
    block title
    link(rel='stylesheet', type='text/css', href=url_for(theme.css) + '/style.css' + '?v=' + theme.version)
    link(rel='stylesheet', type='text/css', href=url_for(theme.css) + '/highlight.css' + '?v=' + theme.version)
    if page.math
      link(rel='stylesheet', href='https://cdn.bootcdn.net/ajax/libs/KaTeX/0.16.9/katex.min.css')
    link(rel='Shortcut Icon', href=url_for('favicon.ico'))
    link(rel="bookmark", href=url_for('favicon.ico'))
    link(rel='apple-touch-icon', href=url_for('apple-touch-icon.png'))
    link(rel='apple-touch-icon-precomposed', href=url_for('apple-touch-icon.png'))
    if config.feed
      link(rel='alternate', type=feed_type, href=url_for(config.feed.path))
    //- pace特效
    //- script(type='text/javascript', src='//cdn.bootcss.com/pace/1.0.2/pace.min.js')
    
  body
    //- 提前应用主题类，避免刷新时闪烁(FOUC)
    script.
      (function () {
        var b = document.body;
        var d = new Date();
        if (d.getMonth() === 11 && d.getDate() === 13) { b.classList.add('gray-theme'); }
        else { b.classList.add('default-theme'); }
        var dark = null;
        try { dark = localStorage.getItem('blueLakeNight'); } catch (e) {}
        if (dark === null) {
          dark = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? '1' : '0';
        }
        if (dark === '1') { b.classList.add('night-theme'); }
      })();
    //- canvas#reactive-bg-canvas
    #particles-js
    canvas#stage1.stage
    .body_container
        #header
          .site-name
            h1.hidden= current_title
            a#logo(href=url_for('.'))= config.title
            p.description= config.subtitle
          #nav-menu
            - for (var i in theme.menu)
              +a_with_current(theme.menu[i].directory, __(theme.menu[i].page), theme.menu[i].icon)
            button#night-toggle(type='button', aria-label='切换到夜间模式', aria-pressed='false', title='切换夜间模式')
              svg(viewBox='0 0 24 24', width='16', height='16', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
                path(d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z')
          include _partial/search
        #layout.layout-g
          .layout-l: .content_container
            block content
          if theme.widgets_on_small_screens
            .layout-r: #sidebar
              if theme.local_search == true
                .search-pla
                block tocmodel
              each item in theme.widgets
                != partial('_widget/' + item + '.jade')
          else
            .layout-r.hidden_mid_and_down: #sidebar
              each item in theme.widgets
                != partial('_widget/' + item + '.jade')
        a#totop(href='#top')
        include _partial/footer
      include _partial/after_footer
      block pageOnly
    //- 粒子特效
    script(type='text/javascript', src='/js/particles.min.js')
    script(type='text/javascript', src='/js/app.js')
    script(type='text/javascript', src='/js/copycode.js' + '?v=' + theme.version)

    script(type='text/javascript', src='/js/baidupush.js')
    script(type='text/javascript', src='/js/darkmode.js' + '?v=' + theme.version)
    if page.math
      script(type='text/javascript', src='https://cdn.bootcdn.net/ajax/libs/KaTeX/0.16.9/katex.min.js', defer)
      script(type='text/javascript', src='https://cdn.bootcdn.net/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js', defer)
      script.
        document.addEventListener('DOMContentLoaded', function () {
          if (typeof renderMathInElement !== 'function') return;
          var el = document.querySelector('.post-content') || document.body;
          renderMathInElement(el, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false },
              { left: '\\[', right: '\\]', display: true },
              { left: '\\(', right: '\\)', display: false }
            ],
            ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option']
          });
        });

