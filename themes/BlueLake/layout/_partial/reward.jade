if theme.reward && theme.reward.enable
  #reward
    button#reward-btn(type='button', aria-expanded='false', aria-controls='reward-panel')
      svg(viewBox='0 0 24 24', width='16', height='16', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
        path(d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z')
      span= theme.reward.button || '赞赏支持'
    #reward-modal
      #reward-mask
      #reward-panel(role='dialog', aria-modal='true', aria-label=(theme.reward.title || '赞赏支持'))
        button#reward-close(type='button', aria-label='关闭')
          svg(viewBox='0 0 24 24', width='18', height='18', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
            line(x1='18', y1='6', x2='6', y2='18')
            line(x1='6', y1='6', x2='18', y2='18')
        if theme.reward.title
          .reward-title= theme.reward.title
        if theme.reward.text
          p.reward-text= theme.reward.text
        .reward-qrs
          if theme.reward.wechat
            figure.reward-qr
              img(src=url_for(theme.reward.wechat), alt='微信赞赏码', loading='lazy')
              figcaption 微信
          if theme.reward.alipay
            figure.reward-qr
              img(src=url_for(theme.reward.alipay), alt='支付宝赞赏码', loading='lazy')
              figcaption 支付宝
