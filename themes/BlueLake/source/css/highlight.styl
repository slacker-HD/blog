      .literal,.number,.built_in
        color: #3882b7
      .meta-string
        color: #183691
  &.perl
    .code
      .title
        color: #5b79e3
      .regexp
        color: #d3604f
      .sub
        color: #5b79e3
  &.php
    .code
      .title
        color: #5b79e3
      .regexp
        color: #d3604f
