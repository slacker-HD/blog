/* syntax highlight*/
pre 
  width: 100%      
  position: relative
  border: none
  padding: 0
  margin: 0
  code 
    display block
    box-sizing: border-box
    overflow-x: auto
    font-family: Source Code Pro, Monaco, Menlo, Consolas, monospace, Arial, sans-serif

    margin: 1.2em 0
    padding 15px 15px 10px 15px
    line-height: 1.2em
    width: 100%
    border-radius: 5px
    border: 1px solid #ececec
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05)
    font-size: 13px
    color: #242529
    background: #fafafa
figure.highlight,.codeblock
  background: #fafafa
  margin: 10px 0
  line-height: 1.1em
  padding-top: 15px
  margin: 1em 0
  border-radius: 5px
  border: 1px solid #ececec
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05)
  figcaption
    font-size: 13px
    padding: 0 15px 20px
    margin: 0
    background: #fafafa
    color: #7e8086
    a
      float: right
      color: #5c78e2
      font-weight: bold
  table
    width: 100%
    margin: 0
    padding-bottom: 10px
    border-collapse: collapse
    position: relative
    display block 
    overflow-x: auto
  pre,.gutter,.code,.tag
    background-color: inherit
    font-family: Source Code Pro, Monaco, Menlo, Consolas, monospace
    border: none
    padding: 0
    margin: 0
    cursor: text
  .gutter,.code
    vertical-align: top
  &.plain
    .gutter
      display: none
  .gutter
    background: #fafafa
    border-right: 1px solid #ececec
    padding: 0.3em 15px
    .line
      color: #b4b4bb
  .line
    font-size: 13px
    color: #242529
    &.marked
      background: #f5e3de

  .code
    padding: 0.3em 15px 0.3em 1em
    width: 100%

.gist .line,.gist .line-number
  font-family: Source Code Pro, Monaco, Menlo, Consolas, monospace
  font-size: 1em
  margin: 0 0 5px 0
/* code highlight color*/
.highlight
  .comment
    color: #a2a3a7
  .title,
  .section
    color: #d3604f
  .meta,
  .preprocessor
    color: #a449ab
  .tag,
  .attr,
  .attribute
    color: #5c78e2
  .string,
  .value,
  .inheritance,
  .header,
  .ruby .symbol,
  .xml .cdatabody
    color: #649f57
  .keyword
    color: #a449ab
  .javascript .function
    color: #5b79e3
  .number,
  .literal,
  .params
    color: #ad6e25
  .built_in,
  .type,
  .operator
    color: #3882b7
  .constant
    color: #c18401
  .regexp
    color: #ad6e26
  .function
    color: #5b79e3
  .symbol,
  .property,
  .doctag
    color: #d3604f
  &.apacheconf
    .code
      .common,.nomarkup,.attribute,.variable,.cbracket,.keyword
        color: #3882b7
      .sqbracket
        color: #d3604f
      .section,.tag
        color: #649f57
  &.bash 
    .code 
      .literal,.built_in
        color: #3882b7
      .title
        color: #5b79e3
      .shebang
        color: #7c7e86
      .variable
        color: #242529
  &.coffeescript 
    .code 
      .subst,.regexp,.attribute
        color: #d3604f
      .literal,.built_in,.number
        color: #3882b7
      .title
        color: #5b79e3
      .reserved,.attribute
        color: #3882b7
  &.cpp,&.c
    .code
      .number,.built_in
        color: #3882b7
      .preprocessor
        color: #d3604f
      .title
        color: #5b79e3
      .meta-keyword
        color: #a449ab
  &.cs 
    .code 
      .preprocessor,.preprocessor .keyword
        color: #242529
      .xmlDocTag,.doctag
        color: #649f57
      .number,.built_in
        color: #3882b7
      .title
        color: #5b79e3
  &.css
    .code 
      .id,.class,.pseudo,.selector-pseudo
        color: #5b79e3
      .attr_selector,.value
        color: #242529
      .attribute,.hexcolor,.number,.function
        color: #3882b7
      .at_rule,.important,.meta
        color: #a449ab    
      .tag,.selector-tag
        color: #649f57   
  &.diff
    .code
      .deletion
        color: #d3604f
        background-color: #f6c6bd
      .addition
        color: #669f59
        background-color: #cde4d6
  &.http
    .code
      .literal
        color: #3882b7
      .request
        color: #a449ab
      .attribute,attr
        color: #183691
  &.ini
    .code
      .value,.keyword
        color: #242529
      .setting,.attr
        color: #a449ab
      .chunk,.meta
        color: #5b79e3
        font-weight: bold
      .title,.section
        color: #5b79e3
  &.js
    .code
      .tag
        .title
          color: #242529
      .regexp
        color: #d3604f
      .javadoc
        color: #7c7e86
      .literal,.number
        color: #3882b7
      .built_in,.title
        color: #5b79e3
      .tag,.javadoctag
        color: #a449ab
  &.java
    .code
      .title
        color: #5b79e3
      .number
        color: #3882b7
      .javadoc
        color: #7c7e86
      .params
        color: #3882b7
      .meta,.annotation,.javadoctag
        color: #a449ab
  &.mak
    .code
      .title
        color: #5b79e3
      .constant
        color: #242529
      .keyword,.meta-keyword
        color: #3882b7        
  &.json
    .code
      .attribute
        color: #183691
      .number,.literal
        color: #3882b7
  &.md
    .code
      .link_url,.link
        text-decoration: underline
      .link_reference,.symbol,.code
        color: #3882b7
      .value,.link_label,.strong,.emphasis,.blockquote,.quote,.section
        color: #183691
  &.nginx
